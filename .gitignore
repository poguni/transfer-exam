# ============================================================
# 편입 캘린더(TExam Calendar) .gitignore
# ============================================================

# ---------- 비밀 값·환경 변수 (절대 커밋 금지) ----------
# Supabase URL·anon 키는 .env.local에 둡니다. .env.example만 커밋합니다.
.env
.env.*
!.env.example
*.local
# 혹시 생길 수 있는 키·인증서 파일
*.pem
*.key
*.p12
*.pfx
service-account*.json
*service_role*

# ---------- 의존성 ----------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.npm/

# ---------- 빌드 결과 ----------
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
# vite-plugin-pwa가 개발 중 만드는 서비스 워커
dev-dist/

# ---------- 테스트·확인 결과 ----------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
# 화면 확인용 스크린샷·PDF (Playwright MCP 포함)
.playwright-mcp/
screenshots/
*.diff.png
# 인쇄 확인용으로 만든 임시 PDF (design/print-samples/의 확정본은 커밋)
tests/**/*.pdf
tmp-print/

# ---------- Supabase 로컬 작업 파일 ----------
# migrations/는 커밋하고, CLI가 만드는 임시 폴더만 뺍니다.
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/functions/.env
supabase/**/*.env.local

# ---------- 로그 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 캐시 ----------
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.temp/
.tmp/
*.tmp

# ---------- 배포 도구 로컬 설정 ----------
.vercel/
.netlify/

# ---------- 앱이 내보내는 사용자 데이터 (개인정보) ----------
# 테스트 중 만든 .ics, JSON 백업에는 수험 번호 등이 들어갈 수 있습니다.
*.ics
tcal-backup*.json
backup/

# ---------- AI 도구 작업 폴더 ----------
# 공유 규칙인 CLAUDE.md는 커밋합니다.
.omc/
.claude/settings.local.json
.claude/worktrees/
.claude/*.local.*

# ---------- 편집기 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---------- 운영체제 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- 오피스 임시 파일 (docs/ 문서 편집 중 생김) ----------
~$*
*.~lock.*#
